<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.railway.supervisor.SupervisorController">
    <top>
        <VBox styleClass="header-panel" spacing="6.0">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="18.0"/>
            </padding>
            <Label styleClass="title-label" text="Indian Railways Supervisor Console"/>
            <Label styleClass="subtitle-label"
                   text="PRS / UTS supervisor terminal · QR Fare Repeater Display"/>
            <Separator styleClass="header-separator"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.62" orientation="VERTICAL" styleClass="console-split">
            <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" minHeight="0.0" pannable="true"
                        styleClass="form-scroll" vbarPolicy="AS_NEEDED">
                <VBox spacing="14.0" styleClass="main-panel">
                    <padding>
                        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0"/>
                    </padding>
                <GridPane hgap="12.0" maxHeight="Infinity" vgap="12.0" VBox.vgrow="NEVER">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" maxWidth="140.0" minWidth="120.0"/>
                        <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity" minWidth="200.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                        <RowConstraints minHeight="32.0" valignment="CENTER"/>
                    </rowConstraints>

                    <Label styleClass="field-label" text="Ticket Type" GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>
                    <ComboBox fx:id="ticketTypeCombo" maxWidth="Infinity" GridPane.columnIndex="1"
                              GridPane.rowIndex="0"/>

                    <Label styleClass="field-label" text="Source Station" GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>
                    <HBox fx:id="sourceStationBox" alignment="CENTER_LEFT" spacing="8.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <TextField fx:id="sourceField" prefWidth="72.0" promptText="Code"/>
                        <TextField fx:id="sourceEngField" HBox.hgrow="ALWAYS" promptText="English name (16)"/>
                        <TextField fx:id="sourceHindiField" HBox.hgrow="ALWAYS" promptText="Hindi name (16)"/>
                    </HBox>

                    <Label styleClass="field-label" text="Destination Station" GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>
                    <HBox fx:id="destStationBox" alignment="CENTER_LEFT" spacing="8.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <TextField fx:id="destinationField" prefWidth="72.0" promptText="Code"/>
                        <TextField fx:id="destEngField" HBox.hgrow="ALWAYS" promptText="English name (16)"/>
                        <TextField fx:id="destHindiField" HBox.hgrow="ALWAYS" promptText="Hindi name (16)"/>
                    </HBox>

                    <Label fx:id="dateLabel" styleClass="field-label" text="Date / Month" GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>
                    <HBox fx:id="dateBox" alignment="CENTER_LEFT" spacing="8.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <TextField fx:id="dayField" prefWidth="64.0" promptText="DD"/>
                        <TextField fx:id="monthField" prefWidth="64.0" promptText="MM"/>
                    </HBox>

                    <Label fx:id="adultChildLabel" styleClass="field-label" text="Adult / Child"
                           GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <HBox fx:id="adultChildBox" alignment="CENTER_LEFT" spacing="8.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <TextField fx:id="adultField" prefWidth="64.0" promptText="Adult"/>
                        <TextField fx:id="childField" prefWidth="64.0" promptText="Child"/>
                    </HBox>

                    <Label fx:id="trainTypeLabel" styleClass="field-label" text="Type of Train"
                           GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="trainTypeCombo" maxWidth="Infinity" GridPane.columnIndex="1"
                              GridPane.rowIndex="5"/>

                    <Label fx:id="classTxnLabel" styleClass="field-label" text="Class / Txn Type"
                           GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <HBox fx:id="classTxnBox" alignment="CENTER_LEFT" spacing="8.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="6">
                        <ComboBox fx:id="classCombo" prefWidth="80.0"/>
                        <ComboBox fx:id="txnTypeCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <Label styleClass="field-label" text="Fare (Rs)" GridPane.columnIndex="0"
                           GridPane.rowIndex="7"/>
                    <TextField fx:id="fareField" promptText="Up to 5 digits" GridPane.columnIndex="1"
                               GridPane.rowIndex="7"/>

                    <Label fx:id="refundLabel" styleClass="field-label" text="Cancel Refund"
                           GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                    <HBox fx:id="refundBox" alignment="CENTER_LEFT" spacing="8.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="8">
                        <TextField fx:id="refundAmountField" promptText="Amount (e.g. 790)"/>
                    </HBox>

                    <Label fx:id="operatorLabel" styleClass="field-label" text="Operator"
                           GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                    <TextField fx:id="operatorField" promptText="Name (25 chars)"
                               GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                    <Label fx:id="terminalLabel" styleClass="field-label" text="Terminal / Win / Shift"
                           GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                    <HBox fx:id="terminalBox" alignment="CENTER_LEFT" spacing="8.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="10">
                        <TextField fx:id="terminalField" prefWidth="88.0" promptText="NDLS99"/>
                        <TextField fx:id="windowField" prefWidth="64.0" promptText="105"/>
                        <TextField fx:id="shiftField" prefWidth="48.0" promptText="3"/>
                    </HBox>

                    <Label fx:id="paymentLabel" styleClass="field-label" text="Pay GW / QR"
                           GridPane.columnIndex="0" GridPane.rowIndex="11"/>
                    <HBox fx:id="paymentBox" alignment="CENTER_LEFT" spacing="8.0"
                          GridPane.columnIndex="1" GridPane.rowIndex="11">
                        <TextField fx:id="paymentGwField" prefWidth="120.0" promptText="Payment GW"/>
                        <TextField fx:id="qrPayloadField" HBox.hgrow="ALWAYS" promptText="QR payload (code 22, optional)"/>
                    </HBox>

                    <Label fx:id="transactionLabel" styleClass="field-label" text="Transaction ID" GridPane.columnIndex="0"
                           GridPane.rowIndex="12"/>
                    <TextField fx:id="transactionField" promptText="Unique transaction reference"
                               GridPane.columnIndex="1" GridPane.rowIndex="12"/>

                    <Label fx:id="passengerNameLabel" styleClass="field-label" text="Passenger Name"
                           GridPane.columnIndex="0" GridPane.rowIndex="13"/>
                    <TextField fx:id="passengerNameField" promptText="Required for PRS"
                               GridPane.columnIndex="1" GridPane.rowIndex="13"/>
                </GridPane>

                <VBox fx:id="prsPanel" managed="false" spacing="12.0" visible="false">
                    <Label styleClass="field-label" text="PRS TDRC (sub-function 111)"/>
                    <GridPane hgap="12.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" maxWidth="140.0" minWidth="120.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label styleClass="field-label" text="Train No" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="prsTrainField" promptText="5 chars e.g. 12420"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label styleClass="field-label" text="Class / Quota" GridPane.columnIndex="0"
                               GridPane.rowIndex="1"/>
                        <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <TextField fx:id="prsClassField" prefWidth="64.0" promptText="CC"/>
                            <TextField fx:id="prsQuotaField" prefWidth="64.0" promptText="GN"/>
                        </HBox>
                        <Label styleClass="field-label" text="Boarding / Res upto" GridPane.columnIndex="0"
                               GridPane.rowIndex="2"/>
                        <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <TextField fx:id="prsBoardingField" prefWidth="80.0" promptText="NDLS"/>
                            <TextField fx:id="prsResUptoField" prefWidth="80.0" promptText="LKO"/>
                        </HBox>
                        <Label styleClass="field-label" text="Operator code" GridPane.columnIndex="0"
                               GridPane.rowIndex="3"/>
                        <TextField fx:id="prsOpCodeField" promptText="6 chars" GridPane.columnIndex="1"
                                   GridPane.rowIndex="3"/>
                        <Label styleClass="field-label" text="Operator name" GridPane.columnIndex="0"
                               GridPane.rowIndex="4"/>
                        <TextField fx:id="prsOpNameField" promptText="20 chars" GridPane.columnIndex="1"
                                   GridPane.rowIndex="4"/>
                        <Label styleClass="field-label" text="Special message" GridPane.columnIndex="0"
                               GridPane.rowIndex="5"/>
                        <TextField fx:id="prsSpecialField" promptText="Optional 25 chars"
                                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        <Label styleClass="field-label" text="QR / display msg" GridPane.columnIndex="0"
                               GridPane.rowIndex="6"/>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                            <TextField fx:id="prsQrField" promptText="UPI string (sub-function 112)"/>
                            <TextField fx:id="prsQrMessageField" promptText="Message after $ (100 chars)"/>
                        </VBox>
                        <Label styleClass="field-label" text="Payment text" GridPane.columnIndex="0"
                               GridPane.rowIndex="7"/>
                        <TextField fx:id="prsPaymentTextField" promptText="113 success / 114 fail (25 chars)"
                                   GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    </GridPane>
                    <Label styleClass="hint-label"
                           text="Passengers: name (16) · sex (1) · age (2) · status / coach-berth e.g. C2 - 43. Empty rows are skipped. Max 6."
                           wrapText="true"/>
                    <VBox fx:id="prsPaxRowsBox" spacing="6.0">
                        <HBox spacing="8.0">
                            <TextField prefWidth="180.0" promptText="Name"/>
                            <TextField prefWidth="48.0" promptText="Sex"/>
                            <TextField prefWidth="48.0" promptText="Age"/>
                            <TextField HBox.hgrow="ALWAYS" promptText="Status e.g. C2 - 43"/>
                        </HBox>
                        <HBox spacing="8.0">
                            <TextField prefWidth="180.0" promptText="Name"/>
                            <TextField prefWidth="48.0" promptText="Sex"/>
                            <TextField prefWidth="48.0" promptText="Age"/>
                            <TextField HBox.hgrow="ALWAYS" promptText="Status"/>
                        </HBox>
                        <HBox spacing="8.0">
                            <TextField prefWidth="180.0" promptText="Name"/>
                            <TextField prefWidth="48.0" promptText="Sex"/>
                            <TextField prefWidth="48.0" promptText="Age"/>
                            <TextField HBox.hgrow="ALWAYS" promptText="Status"/>
                        </HBox>
                        <HBox spacing="8.0">
                            <TextField prefWidth="180.0" promptText="Name"/>
                            <TextField prefWidth="48.0" promptText="Sex"/>
                            <TextField prefWidth="48.0" promptText="Age"/>
                            <TextField HBox.hgrow="ALWAYS" promptText="Status"/>
                        </HBox>
                        <HBox spacing="8.0">
                            <TextField prefWidth="180.0" promptText="Name"/>
                            <TextField prefWidth="48.0" promptText="Sex"/>
                            <TextField prefWidth="48.0" promptText="Age"/>
                            <TextField HBox.hgrow="ALWAYS" promptText="Status"/>
                        </HBox>
                        <HBox spacing="8.0">
                            <TextField prefWidth="180.0" promptText="Name"/>
                            <TextField prefWidth="48.0" promptText="Sex"/>
                            <TextField prefWidth="48.0" promptText="Age"/>
                            <TextField HBox.hgrow="ALWAYS" promptText="Status"/>
                        </HBox>
                    </VBox>
                </VBox>

                <GridPane hgap="12.0" vgap="8.0" styleClass="link-panel">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="120.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="NEVER" minWidth="90.0"/>
                    </columnConstraints>
                    <Label styleClass="field-label" text="Serial port" GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>
                    <TextField fx:id="serialPortField" promptText="e.g. COM5 (DTECH USB-Serial)"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button mnemonicParsing="false" onAction="#onConnectLink" styleClass="secondary-button"
                            text="Connect" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Label styleClass="hint-label" text="9600 8N1 · console TX via USB-serial · controller RX on RS232 · $CodeLengthData^"
                           wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="2"
                           GridPane.rowIndex="1"/>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button mnemonicParsing="false" onAction="#onGenerateTicket" styleClass="primary-button"
                            text="Generate Ticket"/>
                    <Button fx:id="clearDisplayButton" mnemonicParsing="false" onAction="#onClearDisplay"
                            styleClass="secondary-button" text="Clear Display"/>
                    <Button fx:id="refundButton" mnemonicParsing="false" onAction="#onCancellationRefund"
                            styleClass="secondary-button" text="Send Cancellation Refund"/>
                    <Button fx:id="prsPingButton" managed="false" mnemonicParsing="false" onAction="#onPrsPing"
                            styleClass="secondary-button" text="PRS Ping 110" visible="false"/>
                    <Button fx:id="prsPayOkButton" managed="false" mnemonicParsing="false" onAction="#onPrsPayOk"
                            styleClass="secondary-button" text="Payment OK 113" visible="false"/>
                    <Button fx:id="prsPayFailButton" managed="false" mnemonicParsing="false" onAction="#onPrsPayFail"
                            styleClass="secondary-button" text="Payment Fail 114" visible="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                </VBox>
            </ScrollPane>

            <VBox spacing="8.0" styleClass="log-panel">
                <padding>
                    <Insets bottom="16.0" left="20.0" right="20.0" top="12.0"/>
                </padding>
                <Label styleClass="log-title" text="Serial log · packets &amp; status"/>
                <TextArea fx:id="logArea" editable="false" focusTraversable="false" minHeight="120.0"
                          prefRowCount="8" wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
