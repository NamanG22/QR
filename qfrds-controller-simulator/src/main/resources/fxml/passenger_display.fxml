<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!-- RDSO QFRDS receipt-style layouts: paired cells = white maroon-serif label + black value box -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.railway.qfrds.PassengerDisplayView"
            styleClass="passenger-root">
    <center>
        <StackPane styleClass="display-stack">

            <!-- ========================================================== -->
            <!-- ============           UTS BOARD              ============ -->
            <!-- ========================================================== -->
            <BorderPane fx:id="utsBoard" styleClass="pv-uts-board">
                <center>
                    <VBox spacing="8.0" styleClass="pv-uts-canvas" BorderPane.alignment="TOP_LEFT">
                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                        </padding>

                        <!-- header card: Terminal / Windows strips + title -->
                        <VBox styleClass="pv-card-white" VBox.vgrow="NEVER">
                            <HBox alignment="TOP_LEFT" spacing="8.0" styleClass="pv-header-strip-row">
                                <VBox alignment="TOP_CENTER" prefWidth="122.0" minWidth="96.0"
                                      styleClass="pv-strip-cell" maxWidth="140.0">
                                    <Label styleClass="pv-strip-label" text="Terminal ID"/>
                                    <Region styleClass="pv-line-black" prefHeight="2.0" maxWidth="Infinity"/>
                                    <Label fx:id="utsTerminalId" styleClass="pv-strip-value" text=""/>
                                </VBox>
                                <VBox alignment="TOP_CENTER" prefWidth="122.0" minWidth="96.0"
                                      styleClass="pv-strip-cell" maxWidth="140.0">
                                    <Label styleClass="pv-strip-label" text="Windows No."/>
                                    <Region styleClass="pv-line-black" prefHeight="2.0" maxWidth="Infinity"/>
                                    <Label fx:id="utsWindowNo" styleClass="pv-strip-value" text=""/>
                                </VBox>
                                <!-- logo node kept for FXML inject; hidden until a real asset is supplied -->
                                <StackPane managed="false" visible="false" prefWidth="0.0" prefHeight="0.0">
                                    <ImageView fx:id="utsLogoPlaceholder" fitHeight="1.0" fitWidth="1.0"
                                               preserveRatio="true" smooth="true"/>
                                </StackPane>
                            </HBox>
                            <Label styleClass="pv-title-ticket" text="Ticket Information"/>
                        </VBox>

                        <!-- From | To row: 10+40+10+40 % (20/80 of each half) -->
                        <GridPane hgap="4.0" styleClass="pv-row,pv-grid-tight" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="10.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="40.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="10.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="40.0" hgrow="SOMETIMES"/>
                            </columnConstraints>
                            <VBox styleClass="pv-label-block" alignment="TOP_LEFT" GridPane.columnIndex="0"
                                  GridPane.rowIndex="0">
                                <Label styleClass="pv-label-en-lg" text="From"/>
                                <Label styleClass="pv-label-hi-lg" text="कहाँ से"/>
                            </VBox>
                            <StackPane styleClass="pv-value-block" GridPane.columnIndex="1"
                                       GridPane.rowIndex="0">
                                <Label fx:id="utsFrom" styleClass="pv-value-text" text="" wrapText="true"/>
                            </StackPane>
                            <VBox styleClass="pv-label-block" alignment="TOP_LEFT" GridPane.columnIndex="2"
                                  GridPane.rowIndex="0">
                                <Label styleClass="pv-label-en-lg" text="To"/>
                                <Label styleClass="pv-label-hi-lg" text="कहाँ तक"/>
                            </VBox>
                            <StackPane styleClass="pv-value-block" GridPane.columnIndex="3"
                                       GridPane.rowIndex="0">
                                <Label fx:id="utsTo" styleClass="pv-value-text" text="" wrapText="true"/>
                            </StackPane>
                        </GridPane>

                        <!-- Date row + Class / Fare row (two halves, space-x-1) -->
                        <HBox spacing="4.0" styleClass="pv-row" VBox.vgrow="NEVER">
                            <GridPane hgap="4.0" HBox.hgrow="ALWAYS" minWidth="0.0" styleClass="pv-grid-tight">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="20.0" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="40.0" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="20.0" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="20.0" hgrow="SOMETIMES"/>
                                </columnConstraints>
                                <VBox styleClass="pv-label-block" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="pv-label-en-lg" text="Date"/>
                                    <Label styleClass="pv-label-hi-lg" text="दिनांक"/>
                                </VBox>
                                <StackPane styleClass="pv-value-block,pv-value-pad-sm" GridPane.columnIndex="1"
                                           GridPane.rowIndex="0">
                                    <Label fx:id="utsDate" styleClass="pv-value-text-lg" text=""/>
                                </StackPane>
                                <VBox alignment="CENTER" styleClass="pv-label-block,pv-label-stack"
                                       GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label styleClass="pv-label-en-lg" text="Adult"/>
                                    <Region styleClass="pv-line-black" prefHeight="2.0" maxWidth="Infinity"/>
                                    <Label styleClass="pv-label-en-lg" text="Child"/>
                                </VBox>
                                <VBox alignment="CENTER" styleClass="pv-value-block,pv-value-stack"
                                       GridPane.columnIndex="3" GridPane.rowIndex="0">
                                    <Label fx:id="utsAdult" styleClass="pv-value-text-lg" text=""/>
                                    <Region styleClass="pv-line-gray100" prefHeight="2.0" maxWidth="Infinity"/>
                                    <Label fx:id="utsChild" styleClass="pv-value-text-lg" text=""/>
                                </VBox>
                            </GridPane>
                            <GridPane hgap="4.0" HBox.hgrow="ALWAYS" minWidth="0.0" styleClass="pv-grid-tight">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="19.5" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="19.5" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="61.0" hgrow="SOMETIMES"/>
                                </columnConstraints>
                                <VBox alignment="CENTER" styleClass="pv-class-stack" GridPane.columnIndex="0"
                                       GridPane.rowIndex="0">
                                    <Label styleClass="pv-value-text-lg" text="Class"/>
                                    <Region styleClass="pv-line-gray100" prefHeight="2.0" maxWidth="Infinity"/>
                                    <Label fx:id="utsClass" styleClass="pv-class-inner" text=""/>
                                </VBox>
                                <VBox styleClass="pv-label-block,pv-label-px" GridPane.columnIndex="1"
                                       GridPane.rowIndex="0">
                                    <Label styleClass="pv-label-en-lg" text="Fare"/>
                                    <Label styleClass="pv-label-hi-lg" text="किराया"/>
                                </VBox>
                                <StackPane styleClass="pv-fare-maroon" GridPane.columnIndex="2"
                                           GridPane.rowIndex="0">
                                    <Label fx:id="utsFare" styleClass="pv-fare-amount" text=""/>
                                </StackPane>
                            </GridPane>
                        </HBox>

                        <!-- middle: 70% block (py-20, space-y-1) + 30% white (QR lives here) -->
                        <GridPane hgap="4.0" styleClass="pv-row,pv-middle-row" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="70.0" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <VBox spacing="4.0" styleClass="pv-middle-left" GridPane.columnIndex="0"
                                  GridPane.rowIndex="0" maxWidth="Infinity">
                                <padding>
                                    <Insets bottom="20.0" top="20.0"/>
                                </padding>
                                <HBox spacing="4.0" styleClass="pv-row-inner">
                                    <GridPane hgap="4.0" HBox.hgrow="ALWAYS" minWidth="0.0"
                                              styleClass="pv-grid-tight">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="51.0" hgrow="SOMETIMES"/>
                                            <ColumnConstraints percentWidth="49.0" hgrow="SOMETIMES"/>
                                        </columnConstraints>
                                        <VBox styleClass="pv-label-block,pv-pad-md" GridPane.columnIndex="0"
                                              GridPane.rowIndex="0">
                                            <Label styleClass="pv-label-en-xl" text="Type of Train"/>
                                            <Label styleClass="pv-label-hi-xl" text="ट्रेन का प्रकार"/>
                                        </VBox>
                                        <StackPane styleClass="pv-value-block,pv-pad-md" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0">
                                            <Label fx:id="utsTrainType" styleClass="pv-value-text" text=""/>
                                        </StackPane>
                                    </GridPane>
                                    <GridPane hgap="4.0" HBox.hgrow="ALWAYS" minWidth="0.0"
                                              styleClass="pv-grid-tight">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="30.0" hgrow="SOMETIMES"/>
                                            <ColumnConstraints percentWidth="70.0" hgrow="SOMETIMES"/>
                                        </columnConstraints>
                                        <VBox alignment="CENTER" styleClass="pv-label-block,pv-pay-label"
                                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label styleClass="pv-label-en-xl" text="Pay Mode"/>
                                        </VBox>
                                        <StackPane styleClass="pv-value-block,pv-pad-md" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0">
                                            <Label fx:id="utsPayMode" styleClass="pv-value-text" text=""/>
                                        </StackPane>
                                    </GridPane>
                                </HBox>
                                <HBox spacing="4.0" styleClass="pv-row-inner">
                                    <GridPane hgap="4.0" HBox.hgrow="ALWAYS" minWidth="0.0"
                                              styleClass="pv-grid-tight">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="51.0" hgrow="SOMETIMES"/>
                                            <ColumnConstraints percentWidth="49.0" hgrow="SOMETIMES"/>
                                        </columnConstraints>
                                        <VBox alignment="CENTER" styleClass="pv-label-block,pv-txn-label"
                                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label styleClass="pv-label-en-lg" text="Transaction Type"/>
                                        </VBox>
                                        <StackPane styleClass="pv-value-block,pv-pad-md" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0">
                                            <Label fx:id="utsTxnType" styleClass="pv-value-text" text=""/>
                                        </StackPane>
                                    </GridPane>
                                    <Region styleClass="pv-black-fill" HBox.hgrow="ALWAYS" minWidth="0.0"/>
                                </HBox>
                            </VBox>
                            <VBox alignment="CENTER" styleClass="pv-side-white" GridPane.columnIndex="1"
                                  GridPane.rowIndex="0" maxWidth="Infinity">
                                <StackPane fx:id="utsQrPlaceholder" styleClass="qr-frame pv-qr-in-panel"
                                           prefHeight="140.0" prefWidth="140.0">
                                    <Rectangle arcHeight="0.0" arcWidth="0.0" height="140.0"
                                               styleClass="qr-placeholder-rect" width="140.0"/>
                                    <Label styleClass="qr-placeholder-label" text="QR CODE"/>
                                </StackPane>
                                <ImageView fx:id="utsQrImage" fitHeight="136.0" fitWidth="136.0" managed="false"
                                           preserveRatio="true" smooth="true" visible="false"/>
                            </VBox>
                        </GridPane>

                        <!-- Operator row: 70% operator block + 30% railway -->
                        <GridPane hgap="4.0" styleClass="pv-row" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="70.0" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <GridPane hgap="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                      maxWidth="Infinity" styleClass="pv-grid-tight">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25.0" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="75.0" hgrow="SOMETIMES"/>
                                </columnConstraints>
                                <VBox alignment="CENTER" styleClass="pv-label-block,pv-op-label"
                                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="pv-label-en-xl" text="Operator"/>
                                    <Label styleClass="pv-label-en-xl" text="Name"/>
                                </VBox>
                                <StackPane styleClass="pv-black-fill" alignment="CENTER_LEFT"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label fx:id="utsOperator" styleClass="pv-value-text" text=""/>
                                </StackPane>
                            </GridPane>
                            <VBox alignment="CENTER" styleClass="pv-railway-box" GridPane.columnIndex="1"
                                  GridPane.rowIndex="0" maxWidth="Infinity">
                                <Label styleClass="pv-railway-en" text="North Eastern Railway"/>
                                <Label styleClass="pv-railway-hi" text="वाराणसी मंडल"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </center>
            </BorderPane>

            <!-- ========================================================== -->
            <!-- ============           PRS BOARD              ============ -->
            <!-- ========================================================== -->
            <!-- PRS: same layout system as UTS (pv-*), PRS-specific fields preserved -->
            <BorderPane fx:id="prsBoard" managed="false" styleClass="pv-uts-board" visible="false">
                <center>
                    <VBox spacing="8.0" styleClass="pv-uts-canvas" BorderPane.alignment="TOP_LEFT">
                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                        </padding>

                        <!-- header: Operator Code strip + logo + title -->
                        <VBox styleClass="pv-card-white" VBox.vgrow="NEVER">
                            <HBox alignment="TOP_LEFT" spacing="8.0" styleClass="pv-header-strip-row">
                                <VBox alignment="TOP_CENTER" prefWidth="140.0" minWidth="120.0"
                                      styleClass="pv-strip-cell" maxWidth="160.0">
                                    <Label styleClass="pv-strip-label" text="Operator Code"/>
                                    <Region styleClass="pv-line-black" prefHeight="2.0" maxWidth="Infinity"/>
                                    <Label fx:id="prsOperatorCode" styleClass="pv-strip-value" text="CLIENT"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <StackPane alignment="CENTER" styleClass="pv-prs-logo-frame">
                                    <ImageView fx:id="prsLogoPlaceholder" fitHeight="72.0" fitWidth="72.0"
                                               preserveRatio="true" smooth="true"/>
                                    <VBox alignment="CENTER" spacing="0.0" styleClass="pv-prs-logo-fallback">
                                        <Label styleClass="pv-prs-logo-arc" text="INDIAN"/>
                                        <Label styleClass="pv-prs-logo-arc" text="RAILWAYS"/>
                                        <Label styleClass="pv-prs-logo-emblem" text="🚂"/>
                                        <Label styleClass="pv-prs-logo-hi" text="भारतीय रेल"/>
                                    </VBox>
                                </StackPane>
                            </HBox>
                            <Label styleClass="pv-title-ticket" text="Ticket Information"/>
                        </VBox>

                        <!-- From | To -->
                        <GridPane hgap="4.0" styleClass="pv-row,pv-grid-tight" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="10.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="40.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="10.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="40.0" hgrow="SOMETIMES"/>
                            </columnConstraints>
                            <VBox styleClass="pv-label-block" alignment="TOP_LEFT" GridPane.columnIndex="0"
                                  GridPane.rowIndex="0">
                                <Label styleClass="pv-label-en-lg" text="From"/>
                                <Label styleClass="pv-label-hi-lg" text="कहाँ से"/>
                            </VBox>
                            <StackPane styleClass="pv-value-block" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label fx:id="prsFrom" styleClass="pv-value-text" text="" wrapText="true"/>
                            </StackPane>
                            <VBox styleClass="pv-label-block" alignment="TOP_LEFT" GridPane.columnIndex="2"
                                  GridPane.rowIndex="0">
                                <Label styleClass="pv-label-en-lg" text="To"/>
                                <Label styleClass="pv-label-hi-lg" text="कहाँ तक"/>
                            </VBox>
                            <StackPane styleClass="pv-value-block" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <Label fx:id="prsTo" styleClass="pv-value-text" text="" wrapText="true"/>
                            </StackPane>
                        </GridPane>

                        <!-- Train No. | Quota -->
                        <GridPane hgap="4.0" styleClass="pv-row,pv-grid-tight" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="10.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="40.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="10.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="40.0" hgrow="SOMETIMES"/>
                            </columnConstraints>
                            <VBox styleClass="pv-label-block" alignment="TOP_LEFT" GridPane.columnIndex="0"
                                  GridPane.rowIndex="0">
                                <Label styleClass="pv-label-en-lg" text="Train No."/>
                                <Label styleClass="pv-label-hi-lg" text="गाड़ी सं."/>
                            </VBox>
                            <StackPane styleClass="pv-value-block" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label fx:id="prsTrainNo" styleClass="pv-value-text-lg" text=""/>
                            </StackPane>
                            <VBox styleClass="pv-label-block" alignment="TOP_LEFT" GridPane.columnIndex="2"
                                  GridPane.rowIndex="0">
                                <Label styleClass="pv-label-en-lg" text="Quota"/>
                                <Label styleClass="pv-label-hi-lg" text="कोटा"/>
                            </VBox>
                            <StackPane styleClass="pv-value-block" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <Label fx:id="prsQuota" styleClass="pv-value-text-lg" text="GN"/>
                            </StackPane>
                        </GridPane>

                        <!-- Date + Pax | Class + Fare -->
                        <HBox spacing="4.0" styleClass="pv-row" VBox.vgrow="NEVER">
                            <GridPane hgap="4.0" HBox.hgrow="ALWAYS" minWidth="0.0" styleClass="pv-grid-tight">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="20.0" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="40.0" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="20.0" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="20.0" hgrow="SOMETIMES"/>
                                </columnConstraints>
                                <VBox styleClass="pv-label-block" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="pv-label-en-lg" text="Date"/>
                                    <Label styleClass="pv-label-hi-lg" text="दिनांक"/>
                                </VBox>
                                <StackPane styleClass="pv-value-block,pv-value-pad-sm" GridPane.columnIndex="1"
                                           GridPane.rowIndex="0">
                                    <Label fx:id="prsDate" styleClass="pv-value-text-lg" text=""/>
                                </StackPane>
                                <VBox alignment="CENTER" styleClass="pv-label-block,pv-label-stack"
                                       GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label styleClass="pv-label-en-lg" text="Pax"/>
                                    <Region styleClass="pv-line-black" prefHeight="2.0" maxWidth="Infinity"/>
                                    <Label styleClass="pv-label-hi-lg" text="यात्री"/>
                                </VBox>
                                <StackPane styleClass="pv-value-block,pv-value-pad-sm" GridPane.columnIndex="3"
                                           GridPane.rowIndex="0">
                                    <Label fx:id="prsTotalPax" styleClass="pv-value-text-lg" text=""/>
                                </StackPane>
                            </GridPane>
                            <GridPane hgap="4.0" HBox.hgrow="ALWAYS" minWidth="0.0" styleClass="pv-grid-tight">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="19.5" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="19.5" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="61.0" hgrow="SOMETIMES"/>
                                </columnConstraints>
                                <VBox alignment="CENTER" styleClass="pv-class-stack" GridPane.columnIndex="0"
                                       GridPane.rowIndex="0">
                                    <Label styleClass="pv-value-text-lg" text="Class"/>
                                    <Region styleClass="pv-line-gray100" prefHeight="2.0" maxWidth="Infinity"/>
                                    <Label fx:id="prsClass" styleClass="pv-class-inner" text=""/>
                                </VBox>
                                <VBox styleClass="pv-label-block,pv-label-px" GridPane.columnIndex="1"
                                       GridPane.rowIndex="0">
                                    <Label styleClass="pv-label-en-lg" text="Fare"/>
                                    <Label styleClass="pv-label-hi-lg" text="किराया"/>
                                </VBox>
                                <StackPane styleClass="pv-fare-maroon" GridPane.columnIndex="2"
                                           GridPane.rowIndex="0">
                                    <Label fx:id="prsFare" styleClass="pv-fare-amount" text=""/>
                                </StackPane>
                            </GridPane>
                        </HBox>

                        <!-- Boarding Pt. | Reservation Up To -->
                        <GridPane hgap="4.0" styleClass="pv-row,pv-grid-tight" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="14.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="36.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="14.0" hgrow="SOMETIMES"/>
                                <ColumnConstraints percentWidth="36.0" hgrow="SOMETIMES"/>
                            </columnConstraints>
                            <VBox styleClass="pv-label-block" alignment="TOP_LEFT" GridPane.columnIndex="0"
                                  GridPane.rowIndex="0">
                                <Label styleClass="pv-label-en-lg" text="Boarding Pt."/>
                                <Label styleClass="pv-label-hi-lg" text="चढ़ने का स्थान"/>
                            </VBox>
                            <StackPane styleClass="pv-value-block" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label fx:id="prsBoarding" styleClass="pv-value-text-lg" text=""/>
                            </StackPane>
                            <VBox styleClass="pv-label-block" alignment="TOP_LEFT" GridPane.columnIndex="2"
                                  GridPane.rowIndex="0">
                                <Label styleClass="pv-label-en-lg" text="Reservation Up To"/>
                                <Label styleClass="pv-label-hi-lg" text="आरक्षण तक"/>
                            </VBox>
                            <StackPane styleClass="pv-value-block" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <Label fx:id="prsResUpto" styleClass="pv-value-text-lg" text=""/>
                            </StackPane>
                        </GridPane>

                        <!-- passenger table (70%) + payment / QR (30%) -->
                        <GridPane hgap="4.0" styleClass="pv-row,pv-middle-row" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="70.0" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <VBox spacing="4.0" styleClass="pv-prs-table-wrap" GridPane.columnIndex="0"
                                  GridPane.rowIndex="0" maxWidth="Infinity">
                                <padding>
                                    <Insets bottom="8.0" top="8.0"/>
                                </padding>
                                <TableView fx:id="prsPaxTable" prefHeight="180.0" maxHeight="Infinity"
                                           styleClass="prs-pax-table" VBox.vgrow="ALWAYS"/>
                            </VBox>
                            <VBox alignment="TOP_CENTER" spacing="8.0" styleClass="pv-side-white,pv-prs-payment"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity">
                                <Label styleClass="pv-label-en-xl" text="Pay Mode"/>
                                <StackPane fx:id="prsQrPlaceholder" styleClass="qr-frame pv-qr-in-panel"
                                           prefHeight="140.0" prefWidth="140.0">
                                    <Rectangle arcHeight="0.0" arcWidth="0.0" height="140.0"
                                               styleClass="qr-placeholder-rect" width="140.0"/>
                                    <Label styleClass="qr-placeholder-label" text="UPI-QR"/>
                                </StackPane>
                                <ImageView fx:id="prsQrImage" fitHeight="136.0" fitWidth="136.0" managed="false"
                                           preserveRatio="true" smooth="true" visible="false"/>
                                <Label fx:id="prsPayStatus" managed="false" styleClass="pv-label-en-lg"
                                       text="" visible="false" wrapText="true"/>
                            </VBox>
                        </GridPane>

                        <!-- Operator row -->
                        <GridPane hgap="4.0" styleClass="pv-row" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="70.0" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <GridPane hgap="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                      maxWidth="Infinity" styleClass="pv-grid-tight">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25.0" hgrow="SOMETIMES"/>
                                    <ColumnConstraints percentWidth="75.0" hgrow="SOMETIMES"/>
                                </columnConstraints>
                                <VBox alignment="CENTER" styleClass="pv-label-block,pv-op-label"
                                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="pv-label-en-xl" text="Operator"/>
                                    <Label styleClass="pv-label-en-xl" text="Name"/>
                                </VBox>
                                <StackPane styleClass="pv-black-fill" alignment="CENTER_LEFT"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label fx:id="prsOperatorName" styleClass="pv-value-text" text=""/>
                                </StackPane>
                            </GridPane>
                            <VBox alignment="CENTER" styleClass="pv-railway-box" GridPane.columnIndex="1"
                                  GridPane.rowIndex="0" maxWidth="Infinity">
                                <Label styleClass="pv-railway-en" text="North Eastern Railway"/>
                                <Label styleClass="pv-railway-hi" text="वाराणसी मंडल"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </center>
            </BorderPane>

            <!-- TEMP canvas for the new PRS layout. Current UTS/PRS boards are unchanged. -->
            <BorderPane fx:id="designBoard" managed="false" styleClass="pv-design-board" visible="false"/>
        </StackPane>
    </center>
    <bottom>
        <HBox fx:id="passengerFooter" alignment="CENTER_LEFT" styleClass="passenger-footer-tech">
            <padding>
                <Insets bottom="6.0" left="10.0" right="10.0" top="4.0"/>
            </padding>
            <Label fx:id="footerLinkStatus" styleClass="footer-note" text="RS232 —"/>
            <Region prefWidth="12.0"/>
            <Label fx:id="footerLastUpdated" styleClass="footer-note" text="Last updated: —"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="footer-note" text="QFRDS passenger display"/>
        </HBox>
    </bottom>
</BorderPane>
