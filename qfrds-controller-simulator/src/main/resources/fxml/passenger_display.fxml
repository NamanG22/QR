<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!-- RDSO QFRDS-style layouts: UTS vs PRS — manual toggle + ticket-driven data -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.railway.qfrds.PassengerDisplayView"
            maxHeight="768.0" maxWidth="1024.0" minHeight="768.0" minWidth="1024.0"
            styleClass="passenger-root">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="display-chrome-top">
            <Button fx:id="boardModeToggle" mnemonicParsing="false" onAction="#handleBoardToggle"
                    styleClass="board-mode-toggle" text="Switch to PRS"/>
        </HBox>
    </top>
    <center>
        <StackPane maxHeight="694.0" maxWidth="1024.0" styleClass="display-stack">
            <!-- ========== UTS ========== -->
            <BorderPane fx:id="utsBoard" styleClass="tan-board">
                <padding>
                    <Insets bottom="6.0" left="8.0" right="8.0" top="4.0"/>
                </padding>
                <top>
                    <VBox spacing="0.0">
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="rdso-header-bar">
                            <HBox alignment="CENTER_LEFT" spacing="16.0">
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Label styleClass="rdso-header-micro" text="Terminal ID:"/>
                                    <Label fx:id="utsTerminalId" styleClass="rdso-header-micro" text="—"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Label styleClass="rdso-header-micro" text="Windows No:"/>
                                    <Label fx:id="utsWindowNo" styleClass="rdso-header-micro" text="—"/>
                                </HBox>
                            </HBox>
                            <StackPane HBox.hgrow="ALWAYS">
                                <VBox alignment="CENTER" spacing="2.0">
                                    <Label styleClass="rdso-main-title" text="Ticket Information"/>
                                    <Label styleClass="rdso-main-subtitle" text="टिकट जानकारी"/>
                                </VBox>
                            </StackPane>
                            <ImageView fx:id="utsLogoPlaceholder" fitHeight="60.0" fitWidth="60.0"
                                       preserveRatio="true" smooth="true"/>
                        </HBox>
                    </VBox>
                </top>
                <center>
                    <VBox spacing="0.0" BorderPane.alignment="TOP_LEFT">
                        <!-- Row 1: From / To -->
                        <HBox spacing="0.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell-station">
                                <Label styleClass="rdso-bilingual-label" text="FROM / कहाँ से"/>
                                <Label fx:id="utsFrom" styleClass="rdso-value-large" text="—" wrapText="true"/>
                            </VBox>
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell-station">
                                <Label styleClass="rdso-bilingual-label" text="TO / कहाँ तक"/>
                                <Label fx:id="utsTo" styleClass="rdso-value-large" text="—" wrapText="true"/>
                            </VBox>
                        </HBox>
                        <!-- Row 2: Date / Adult / Child / Class / Fare / QR -->
                        <HBox spacing="0.0">
                            <VBox spacing="4.0" prefWidth="140.0" styleClass="field-shell">
                                <Label styleClass="rdso-bilingual-label" text="DATE / दिनांक"/>
                                <Label fx:id="utsDate" styleClass="rdso-value" text="—"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="72.0" styleClass="field-shell">
                                <Label styleClass="rdso-bilingual-label" text="ADULT / वयस्क"/>
                                <Label fx:id="utsAdult" styleClass="rdso-value" text="0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="72.0" styleClass="field-shell">
                                <Label styleClass="rdso-bilingual-label" text="CHILD / बाल"/>
                                <Label fx:id="utsChild" styleClass="rdso-value" text="0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="88.0" styleClass="field-shell">
                                <Label styleClass="rdso-bilingual-label" text="CLASS / श्रेणी"/>
                                <Label fx:id="utsClass" styleClass="rdso-value" text="—"/>
                            </VBox>
                            <VBox spacing="4.0" HBox.hgrow="SOMETIMES" styleClass="fare-highlight">
                                <Label styleClass="rdso-bilingual-label" text="FARE / किराया"/>
                                <Label fx:id="utsFare" styleClass="rdso-value-large" text="—"/>
                            </VBox>
                            <StackPane prefHeight="120.0" prefWidth="120.0" styleClass="field-shell">
                                <StackPane fx:id="utsQrPlaceholder">
                                    <Rectangle arcHeight="0.0" arcWidth="0.0" height="120.0"
                                               styleClass="qr-placeholder-rect" width="120.0"/>
                                    <Label styleClass="qr-placeholder-label" text="QR CODE"/>
                                </StackPane>
                                <ImageView fx:id="utsQrImage" fitHeight="116.0" fitWidth="116.0" managed="false"
                                           preserveRatio="true" smooth="true" visible="false"/>
                            </StackPane>
                        </HBox>
                        <!-- Row 3: Train type / Pay mode -->
                        <HBox spacing="0.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                <Label styleClass="rdso-bilingual-label" text="TYPE OF TRAIN / ट्रेन का प्रकार"/>
                                <Label fx:id="utsTrainType" styleClass="rdso-value" text="—"/>
                            </VBox>
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                <Label styleClass="rdso-bilingual-label" text="PAY MODE / भुगतान विधि"/>
                                <Label fx:id="utsPayMode" styleClass="rdso-value" text="—"/>
                            </VBox>
                        </HBox>
                        <!-- Row 4: Transaction -->
                        <VBox spacing="4.0" styleClass="field-shell">
                            <Label styleClass="rdso-bilingual-label" text="TRANSACTION TYPE / लेनदेन प्रकार"/>
                            <Label fx:id="utsTxnType" styleClass="rdso-value" text="—"/>
                        </VBox>
                        <!-- Row 5: Operator / Railway -->
                        <HBox alignment="CENTER_LEFT" spacing="0.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                <Label styleClass="rdso-bilingual-label" text="OPERATOR NAME / संचालक नाम"/>
                                <Label fx:id="utsOperator" styleClass="rdso-value" text="—"/>
                            </VBox>
                            <VBox alignment="CENTER_RIGHT" spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                <Region prefHeight="1.0"/>
                                <Label styleClass="railway-division" text="North Eastern Railway / वाराणसी मंडल"
                                       textAlignment="RIGHT"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </center>
            </BorderPane>

            <!-- ========== PRS ========== -->
            <BorderPane fx:id="prsBoard" managed="false" styleClass="tan-board" visible="false">
                <padding>
                    <Insets bottom="6.0" left="8.0" right="8.0" top="4.0"/>
                </padding>
                <top>
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="rdso-header-bar">
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <Label styleClass="rdso-main-title" text="Ticket Information"/>
                            <Label styleClass="rdso-main-subtitle" text="टिकट जानकारी"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                                <Label styleClass="rdso-header-micro" text="Operator Code:"/>
                                <Label fx:id="prsOperatorCode" styleClass="rdso-header-micro" text="CLIENT"/>
                            </VBox>
                            <ImageView fx:id="prsLogoPlaceholder" fitHeight="60.0" fitWidth="60.0"
                                       preserveRatio="true" smooth="true"/>
                        </HBox>
                    </HBox>
                </top>
                <center>
                    <HBox spacing="0.0" BorderPane.alignment="TOP_LEFT">
                        <VBox spacing="0.0" HBox.hgrow="ALWAYS">
                            <HBox spacing="0.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell-station">
                                    <Label styleClass="rdso-bilingual-label" text="FROM / कहाँ से"/>
                                    <Label fx:id="prsFrom" styleClass="rdso-value-large" text="—" wrapText="true"/>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell-station">
                                    <Label styleClass="rdso-bilingual-label" text="TO / कहाँ तक"/>
                                    <Label fx:id="prsTo" styleClass="rdso-value-large" text="—" wrapText="true"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="0.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                    <Label styleClass="rdso-bilingual-label" text="TRAIN NO. / गाड़ी सं."/>
                                    <Label fx:id="prsTrainNo" styleClass="rdso-value-large" text="—"/>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                    <Label styleClass="rdso-bilingual-label" text="QUOTA / कोटा"/>
                                    <Label fx:id="prsQuota" styleClass="rdso-value" text="GN"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="0.0">
                                <VBox spacing="4.0" prefWidth="120.0" styleClass="field-shell">
                                    <Label styleClass="rdso-bilingual-label" text="DATE / दिनांक"/>
                                    <Label fx:id="prsDate" styleClass="rdso-value" text="—"/>
                                </VBox>
                                <VBox spacing="4.0" prefWidth="120.0" styleClass="field-shell">
                                    <Label styleClass="rdso-bilingual-label" text="TOTAL PASSENGERS / कुल यात्री"/>
                                    <Label fx:id="prsTotalPax" styleClass="rdso-value" text="—"/>
                                </VBox>
                                <VBox spacing="4.0" prefWidth="88.0" styleClass="field-shell">
                                    <Label styleClass="rdso-bilingual-label" text="CLASS / श्रेणी"/>
                                    <Label fx:id="prsClass" styleClass="rdso-value" text="—"/>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="fare-highlight">
                                    <Label styleClass="rdso-bilingual-label" text="FARE / किराया"/>
                                    <Label fx:id="prsFare" styleClass="rdso-value-large" text="—"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="0.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                    <Label styleClass="rdso-bilingual-label" text="BOARDING POINT / चढ़ने का स्थान"/>
                                    <Label fx:id="prsBoarding" styleClass="rdso-value" text="—"/>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                    <Label styleClass="rdso-bilingual-label" text="RESERVATION UP TO / आरक्षण तक"/>
                                    <Label fx:id="prsResUpto" styleClass="rdso-value" text="—"/>
                                </VBox>
                            </HBox>
                            <TableView fx:id="prsPaxTable" prefHeight="172.0" styleClass="prs-pax-table"
                                       VBox.vgrow="NEVER"/>
                            <HBox alignment="CENTER_LEFT" spacing="0.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                    <Label styleClass="rdso-bilingual-label" text="OPERATOR NAME / संचालक नाम"/>
                                    <Label fx:id="prsOperatorName" styleClass="rdso-value" text="—"/>
                                </VBox>
                                <Region prefWidth="12.0" HBox.hgrow="SOMETIMES"/>
                                <VBox alignment="CENTER_RIGHT" spacing="4.0" HBox.hgrow="ALWAYS" styleClass="field-shell">
                                    <Region prefHeight="1.0"/>
                                    <Label styleClass="railway-division" text="North Eastern Railway / वाराणसी मंडल"
                                           textAlignment="RIGHT"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox alignment="TOP_CENTER" spacing="8.0" prefWidth="148.0" styleClass="field-shell">
                            <Label styleClass="payment-banner-prs" text="PAYMENT MODE"/>
                            <StackPane prefHeight="130.0" prefWidth="130.0">
                                <StackPane fx:id="prsQrPlaceholder">
                                    <Rectangle arcHeight="0.0" arcWidth="0.0" height="130.0"
                                               styleClass="qr-placeholder-rect" width="130.0"/>
                                    <Label styleClass="qr-placeholder-label" text="UPI-QR CODE"/>
                                </StackPane>
                                <ImageView fx:id="prsQrImage" fitHeight="126.0" fitWidth="126.0" managed="false"
                                           preserveRatio="true" smooth="true" visible="false"/>
                            </StackPane>
                        </VBox>
                    </HBox>
                </center>
            </BorderPane>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="passenger-footer-tech">
            <padding>
                <Insets bottom="6.0" left="10.0" right="10.0" top="4.0"/>
            </padding>
            <Label fx:id="footerLastUpdated" styleClass="footer-note" text="Last updated: —"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="footer-note" text="QFRDS display · F11 fullscreen"/>
        </HBox>
    </bottom>
</BorderPane>
