<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.railway.qfrds</groupId>
    <artifactId>qfrds-controller-simulator</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>QFRDS Controller Simulator</name>
    <description>Remote Data Acquisition Intelligent Controller simulator for Indian Railways QFRDS demo</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <jserialcomm.version>2.10.4</jserialcomm.version>
        <zxing.version>3.5.3</zxing.version>
        <jpackage.maven.plugin.version>1.6.5</jpackage.maven.plugin.version>
        <jpackage.app.name>QFRDS</jpackage.app.name>
        <jpackage.app.version>1.0.0</jpackage.app.version>
        <jpackage.main.class>com.railway.qfrds.Launcher</jpackage.main.class>
        <jpackage.input.dir>${project.build.directory}/jpackage-input</jpackage.input.dir>
        <jpackage.runtime.dir>${project.build.directory}/qfrds-runtime</jpackage.runtime.dir>
        <jpackage.dist.dir>${project.build.directory}/dist</jpackage.dist.dir>
        <javafx.jmods.url>https://download2.gluonhq.com/openjfx/${javafx.version}/openjfx-${javafx.version}_jmods-windows_x64_bin.zip</javafx.jmods.url>
        <javafx.jmods.zip>${project.build.directory}/javafx-jmods.zip</javafx.jmods.zip>
        <javafx.jmods.dir>${project.build.directory}/javafx-jmods</javafx.jmods.dir>
        <!-- Set true once to surface launch errors in a console window on Windows -->
        <jpackage.win.console>false</jpackage.win.console>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>${jserialcomm.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${jpackage.main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${jpackage.main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Windows 10 standalone QFRDS.exe (bundled JRE + JavaFX). Must run on Windows with JDK 17+. -->
    <profiles>
        <profile>
            <id>windows-jpackage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>enforce-windows-jpackage</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireOS>
                                            <family>windows</family>
                                        </requireOS>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.9.0</version>
                        <executions>
                            <execution>
                                <id>fetch-javafx-jmods</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>wget</goal>
                                </goals>
                                <configuration>
                                    <url>${javafx.jmods.url}</url>
                                    <outputFileName>javafx-jmods.zip</outputFileName>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>unzip-javafx-jmods</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${javafx.jmods.dir}" quiet="true"/>
                                        <delete dir="${project.build.directory}/javafx-jmods-unpack" quiet="true"/>
                                        <mkdir dir="${project.build.directory}/javafx-jmods-unpack"/>
                                        <mkdir dir="${javafx.jmods.dir}"/>
                                        <unzip src="${javafx.jmods.zip}" dest="${project.build.directory}/javafx-jmods-unpack"/>
                                        <copy todir="${javafx.jmods.dir}" flatten="true">
                                            <fileset dir="${project.build.directory}/javafx-jmods-unpack" includes="**/*.jmod"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>stage-jpackage-classpath-deps</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input.dir}</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <excludeGroupIds>org.openjfx</excludeGroupIds>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stage-jpackage-app-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>${project.groupId}</groupId>
                                            <artifactId>${project.artifactId}</artifactId>
                                            <version>${project.version}</version>
                                            <type>jar</type>
                                            <destFileName>${project.build.finalName}.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                    <outputDirectory>${jpackage.input.dir}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jlink-qfrds-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jlink</executable>
                                    <arguments>
                                        <argument>--module-path</argument>
                                        <argument>${java.home}/jmods${path.separator}${javafx.jmods.dir}</argument>
                                        <argument>--add-modules</argument>
                                        <argument>java.base,java.logging,javafx.controls,javafx.fxml,javafx.graphics</argument>
                                        <argument>--strip-debug</argument>
                                        <argument>--no-header-files</argument>
                                        <argument>--no-man-pages</argument>
                                        <argument>--compress=2</argument>
                                        <argument>--output</argument>
                                        <argument>${jpackage.runtime.dir}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>${jpackage.maven.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>qfrds-win-exe</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <name>${jpackage.app.name}</name>
                                    <appVersion>${jpackage.app.version}</appVersion>
                                    <vendor>Indian Railways QFRDS</vendor>
                                    <description>QFRDS Controller Simulator passenger display</description>
                                    <destination>${jpackage.dist.dir}</destination>
                                    <input>${jpackage.input.dir}</input>
                                    <runtimeImage>${jpackage.runtime.dir}</runtimeImage>
                                    <mainJar>${project.build.finalName}.jar</mainJar>
                                    <mainClass>${jpackage.main.class}</mainClass>
                                    <type>APP_IMAGE</type>
                                    <winConsole>${jpackage.win.console}</winConsole>
                                    <winMenu>false</winMenu>
                                    <winShortcut>false</winShortcut>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Passenger window only (no engineering UI, no serial). Run: mvn -Ppassenger-display-only javafx:run -->
        <profile>
            <id>passenger-display-only</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.railway.qfrds.PassengerDisplayOnlyApp</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
