<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.railway.qfrds</groupId>
    <artifactId>qfrds-controller-simulator</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>QFRDS Controller Simulator</name>
    <description>Remote Data Acquisition Intelligent Controller simulator for Indian Railways QFRDS demo</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <jserialcomm.version>2.10.4</jserialcomm.version>
        <zxing.version>3.5.3</zxing.version>
        <jpackage.maven.plugin.version>1.6.5</jpackage.maven.plugin.version>
        <jpackage.app.name>QFRDS</jpackage.app.name>
        <jpackage.app.version>1.0.0</jpackage.app.version>
        <jpackage.runtime.dir>${project.build.directory}/qfrds-runtime</jpackage.runtime.dir>
        <jpackage.dist.dir>${project.build.directory}/dist</jpackage.dist.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>${jserialcomm.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.railway.qfrds.MainApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.railway.qfrds/com.railway.qfrds.MainApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Windows 10 standalone QFRDS.exe (bundled JRE + JavaFX). Must run on Windows with JDK 17+. -->
    <profiles>
        <profile>
            <id>windows-jpackage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>enforce-windows-jpackage</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireOS>
                                            <family>windows</family>
                                        </requireOS>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jlink-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jlink</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.railway.qfrds/com.railway.qfrds.MainApp</mainClass>
                                    <jlinkImageName>qfrds-runtime</jlinkImageName>
                                    <launcher>QFRDS</launcher>
                                    <stripDebug>true</stripDebug>
                                    <noManPages>true</noManPages>
                                    <noHeaderFiles>true</noHeaderFiles>
                                    <compress>2</compress>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>${jpackage.maven.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>qfrds-win-exe</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <name>${jpackage.app.name}</name>
                                    <appVersion>${jpackage.app.version}</appVersion>
                                    <vendor>Indian Railways QFRDS</vendor>
                                    <description>QFRDS Controller Simulator passenger display</description>
                                    <destination>${jpackage.dist.dir}</destination>
                                    <runtimeImage>${jpackage.runtime.dir}</runtimeImage>
                                    <type>APP_IMAGE</type>
                                    <winConsole>false</winConsole>
                                    <winMenu>false</winMenu>
                                    <winShortcut>false</winShortcut>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Passenger window only (no engineering UI, no serial). Run: mvn -Ppassenger-display-only javafx:run -->
        <profile>
            <id>passenger-display-only</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.railway.qfrds/com.railway.qfrds.PassengerDisplayOnlyApp</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
